# Configuración del backend local
VITE_BACKEND_URL=http://localhost:5001

# Configuración de GeoServer
VITE_GEOSERVER_WORKSPACE=radar

# Configuración del servidor de radar remoto
# Cambiar por la IP real de la PC remota
VITE_REMOTE_RADAR_URL=http://192.168.1.100:8080

# Ejemplo de configuración para diferentes entornos:
# Desarrollo local: http://localhost:8080
# Red local: http://192.168.1.100:8080
# Servidor remoto: http://servidor-remoto.com:8080
