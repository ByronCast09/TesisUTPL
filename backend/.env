PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=byronPost
DB_NAME=radar_metadata
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DATABASE_URL=postgresql://postgres:byronPost@localhost:5432/radar_metadata
NODE_ENV=development
# Activar almacenamiento de PNGs en BD
STORE_PNG_IN_DB=true

# ✅ Sincronización automática desde PC remotas (NECESARIO para traer PNG y metadatos)
# Las PC remotas procesan los archivos y esta PC local los descarga automáticamente
ENABLE_PNG_SYNC=true
PNG_SYNC_INTERVAL=300000  # Sincronizar cada 5 minutos (igual que frecuencia del radar)

# Monitoreo automático de archivos (solo para PC remota que genera los PNG)
# En PC local estas deben estar en false
ENABLE_PPI_WATCHER=false
ENABLE_PNG_UPLOADER=false 
ENABLE_PPI_PROCESSING=false
# --- Remote radar source ---
RADAR_PIPELINE_REMOTE_HOST=100.88.71.120
RADAR_PIPELINE_REMOTE_PORT=22
RADAR_PIPELINE_REMOTE_USER=radar_sync
RADAR_PIPELINE_REMOTE_PASSWORD=MiClaveSegura123!

# TEMPORALMENTE DESACTIVADO para evitar sobrecargar el servidor
# RADAR_LGUAXX_URL=http://100.88.71.120:8080/

# URL del servidor para LOXX (agregar trailing slash para consistencia)
# Si LOXX está en el mismo servidor que LGUAXX, usa la misma URL
# Si está en servidor diferente, verifica que sea# Radares a monitorear (URLs de servidores Python remotos)
RADAR_LOXX_URL=http://100.100.81.47:8080
RADAR_LGUAXX_URL=http://100.88.71.120:8080

# Timeouts aumentados especialmente para LOXX que tiene conexión más lenta
# LOXX tiene problemas intermitentes de conexión que requieren timeouts más largos
RADAR_REMOTE_INDEX_TIMEOUT_MS=600000        # 10 minutos para obtener índice (LOXX es lento)
RADAR_REMOTE_FILE_TIMEOUT_MS=300000         # 5 minutos para descargar cada archivo

# --- Radar directories (solo para PC remota que procesa .nc directamente) ---
# En PC local con PNG Sync, estos NO son necesarios
RADAR_PIPELINE_RADAR_IDS=LGUAXX
RADAR_PIPELINE_RADARS=LGUAXX:D:/Rainview-Analyzer/Rainview-Analyzer/rainbow/online/RS19/100km.ppi
RADAR_PIPELINE_DATASETS=LGUAXX:Band1

# --- Pipeline y Tareas Programadas ---
# ❌ DESACTIVADO: Pipeline que procesa archivos .nc directamente vía SFTP
# No es necesario porque las PC remotas ya procesan y generan PNG
ENABLE_RADAR_PIPELINE=false

# ❌ DESACTIVADO: Descarga programada de PNG
# PNG Sync Service ya se encarga de sincronizar automáticamente cada 5 min
ENABLE_PNG_DOWNLOAD_SCHEDULED=false

# --- Processing options ---
RADAR_PIPELINE_CRON=*/5 * * * *
RADAR_PIPELINE_RETENTION_HOURS=720
RADAR_PIPELINE_VMIN=0
RADAR_PIPELINE_VMAX=60
RADAR_PIPELINE_TRANSPARENT_BELOW=0
RADAR_PIPELINE_COLORMAP=turbo

# --- Firebase storage ---
RADAR_PIPELINE_FIREBASE_ENABLED=false
RADAR_PIPELINE_FIREBASE_UPLOAD_H5=false
RADAR_PIPELINE_FIREBASE_PREFIX=radar
FIREBASE_STORAGE_BUCKET=radartesis.appspot.com
FIREBASE_SERVICE_ACCOUNT=./tesis_utpl/backend/firebase-key.json
RADAR_PIPELINE_MAX_CONCURRENCY=4

# Monitoreo automático de archivos H5 comprimidos (LOXX)
ENABLE_H5_WATCHER=true

# Directorios para LOXX
H5_DATA_PATH_LOXX=F:\LOXX\H5
PNG_OUTPUT_PATH_LOXX=F:\LOXX\PNG_OUTPUT

# Monitoreo automático de PNGs (para subir a PostgreSQL)
ENABLE_PNG_UPLOADER=true
PNG_OUTPUT_PATH_LOXX=F:\LOXX\PNG_OUTPUT

# Python
PYTHON_CMD=python

# Resincronización forzada de LOXX al iniciar
# Solo activar si necesitas reemplazar archivos corruptos desde servidor remoto
FORCE_RESYNC_LOXX_ON_START=false

# --- Rate Limiting ---
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX=500          # Máximo 500 peticiones por ventana (aumentado para visor)
RATE_LIMIT_WINDOW=15        # Ventana de 15 minutos