# ====================================
# CONFIGURACIÓN DE OPTIMIZACIÓN DE RENDIMIENTO
# ====================================

# Connection Pool para PostgreSQL (Optimización para múltiples usuarios)
# Máximo de conexiones simultáneas al pool
DB_POOL_MAX=50

# Mínimo de conexiones mantenidas abiertas
DB_POOL_MIN=5

# Tiempo de espera para obtener una conexión (ms)
DB_CONNECTION_TIMEOUT=5000

# Tiempo antes de cerrar conexiones inactivas (ms)
DB_IDLE_TIMEOUT=30000

# Habilitar compresión HTTP (reduce ancho de banda 70-90%)
ENABLE_COMPRESSION=true

# Nivel de compresión (1-9, recomendado: 6)
COMPRESSION_LEVEL=6

# Habilitar rate limiting (prevenir abuso)
ENABLE_RATE_LIMIT=true

# Máximo de requests por ventana de tiempo
RATE_LIMIT_MAX=100

# Ventana de tiempo para rate limiting (minutos)
RATE_LIMIT_WINDOW=15
